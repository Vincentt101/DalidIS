<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Notification access -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_permissions" />

        <TextView
            android:id="@+id/notification_access_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notification_access_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_notification_access" />

        <TextView
            android:id="@+id/restricted_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/restricted_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/app_info_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_app_info"
            android:visibility="gone" />

        <TextView
            android:id="@+id/battery_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/battery_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/disable_battery_optimization" />

        <!-- Voice -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_voice" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/enabled_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/announce_payments" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/test_voice_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/test_voice"
            app:icon="@drawable/ic_volume" />

        <!-- Watched apps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/SectionHeader"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/section_apps" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_app_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/add_app" />
        </LinearLayout>

        <TextView
            android:id="@+id/empty_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_apps"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/apps_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- Debug -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_last" />

        <TextView
            android:id="@+id/last_captured"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textIsSelectable="true" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
